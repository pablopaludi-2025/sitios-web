# =============================================================================
#  deploy.env.example — Configuración para deploy.sh
# =============================================================================
#  Copiá este archivo a deploy.env y completá los valores:
#    cp deploy.env.example deploy.env
#    nano deploy.env
#
#  NUNCA commitees deploy.env al repositorio (está en .gitignore)
# =============================================================================

# ── GitHub ────────────────────────────────────────────────────────────────────
# Token de acceso a GitHub para clonar/actualizar el repositorio
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rama a deployar (default: main)
BRANCH=main

# ── Dominios ──────────────────────────────────────────────────────────────────
# Dominio para la app React (apuntalo al IP del servidor en tu DNS)
APP_DOMAIN=dev.vendemas.soynico.ai

# Dominio para la API de Supabase (apuntalo al IP del servidor en tu DNS)
SUPABASE_DOMAIN=api.dev.vendemas.soynico.ai

# Dominio para Supabase Studio (apuntalo al IP del servidor en tu DNS)
STUDIO_DOMAIN=studio.dev.vendemas.soynico.ai

# ── Base de datos ─────────────────────────────────────────────────────────────
# Contraseña para PostgreSQL (mínimo 16 caracteres, sin caracteres especiales raros)
DB_PASSWORD=cambia_esto_por_una_password_segura_1234

# ── APIs externas ─────────────────────────────────────────────────────────────
# API Key de OpenRouter (para el chatbot con Gemini Flash)
# Obtenela en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Opcionales ────────────────────────────────────────────────────────────────
# Directorio de instalación (default: /opt/sitios-web)
# DEPLOY_DIR=/opt/sitios-web

# Usuario del dashboard de Supabase Studio (default: admin)
# DASHBOARD_USERNAME=admin
